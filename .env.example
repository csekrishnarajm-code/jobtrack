# Copy this file to .env and change the values.
# SECRET_KEY is shared by Django (signs JWTs) and FastAPI (verifies JWTs).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=*

POSTGRES_DB=jobtrack
POSTGRES_USER=jobtrack
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
